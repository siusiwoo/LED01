<Window x:Class="LED01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LED01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="87*"/>
            <ColumnDefinition Width="713*"/>
        </Grid.ColumnDefinitions>
        <Rectangle HorizontalAlignment="Left" Height="97" Stroke="Black" VerticalAlignment="Top" Width="800" Grid.ColumnSpan="3"/>
        <Button Content="시작" HorizontalAlignment="Left" Height="48" Margin="10,20,0,0" VerticalAlignment="Top" Width="146" Click="Start_Click" Grid.ColumnSpan="3" x:Name="StartButton" />
        <Button Content="중지" HorizontalAlignment="Left" Height="48" Margin="94,20,0,0" VerticalAlignment="Top" Width="146" Click="Stop_Click" Grid.Column="2" PreviewMouseLeftButtonDown="Stop_Down"
        PreviewMouseLeftButtonUp="Stop_Up" x:Name="StopButton" />
        <TextBox HorizontalAlignment="Left" Margin="272,26,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Height="42" x:Name="WorkCount" TextChanged="workCount_TextChanged" Grid.Column="2" PreviewTextInput="WorkCount_PreviewTextInput"/>
        <DataGrid Grid.ColumnSpan="3" HorizontalAlignment="Left" Height="173" Margin="0,97,0,0" VerticalAlignment="Top" Width="800" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="DataGrid_SelectionChanged" x:Name="CalculationHistory" IsReadOnly="True" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="A" Binding="{Binding A}" />
                <DataGridTextColumn Header="B" Binding="{Binding B}" />
                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" />
                <DataGridTextColumn Header="Result" Binding="{Binding Result}" />
            </DataGrid.Columns>
        </DataGrid>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,270,0,0" x:Name="CommunicationLog" SelectionChanged="communicationLog_SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Height="164" Width="800" Grid.ColumnSpan="3"/>
        <Ellipse HorizontalAlignment="Left" Height="45" Margin="453,26,0,0" Stroke="Black" VerticalAlignment="Top" Width="44" RenderTransformOrigin="0.851,0.575" x:Name="Green" Grid.Column="2" />
        <Ellipse HorizontalAlignment="Left" Height="45" Margin="535,26,0,0" Stroke="Black" VerticalAlignment="Top" Width="44" x:Name="Yellow" Grid.Column="2" />
        <Ellipse HorizontalAlignment="Left" Height="46" Margin="620,26,0,0" Stroke="Black" VerticalAlignment="Top" Width="44" x:Name="Red" Grid.Column="2"/>
        
        
    </Grid>
</Window>
